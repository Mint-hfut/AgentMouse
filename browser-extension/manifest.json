{
  "manifest_version": 3,
  "name": "AgentMouse Browser Bridge",
  "version": "0.6.0",
  "description": "Background page images and pixel-based mouse gestures without taking over your system pointer.",
  "key": "",
  "permissions": [
    "debugger",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:*"
  },
  "version_name": "0.6.0-beta.2"
}
