{
  "name": "agentmouse",
  "version": "0.7.0-beta.3",
  "private": true,
  "type": "module",
  "description": "Background computer use for AI agents with an independent pointer, MCP server, Agent Skills, and multi-agent-host installers.",
  "bin": {
    "agentmouse": "./agentmouse.mjs"
  },
  "files": [
    "mcp-server.mjs",
    "agentmouse.mjs",
    "browser-pointer.mjs",
    "browser-router.mjs",
    "bridge-client.mjs",
    "bridge-server.mjs",
    "browser-extension/",
    "install.cmd",
    "install.mjs",
    "scripts/install-lib.mjs",
    "scripts/install-plugins.mjs",
    "scripts/build-native.mjs",
    "scripts/browser-setup.mjs",
    "scripts/bridge-daemon.mjs",
    "marketplace.json",
    ".agents/plugins/marketplace.json",
    "plugin.json",
    "mcp.json",
    ".mcp.json",
    ".claude-plugin/",
    ".codex-plugin/",
    ".zcode-plugin/",
    "skills/",
    "commands/",
    "adapters/",
    "assets/",
    "dist/AgentMouse.exe",
    "dist/AgentMouse.Cli.exe",
    "README.zh.md",
    "README.md",
    "docs/",
    "fusion-entry.mjs",
    "fusion-worker.mjs",
    "scripts/fusion-setup.mjs",
    "vendor/windows-mcp/pyproject.toml",
    "vendor/windows-mcp/uv.lock",
    "vendor/windows-mcp/README.md",
    "vendor/windows-mcp/LICENSE.md",
    "THIRD_PARTY_NOTICES.md",
    "fusion/client.py",
    "fusion/engine.py",
    "fusion/server.py",
    "fusion/controls.py",
    "vendor/windows-mcp/src/**/*.py"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node mcp-server.mjs",
    "build": "node scripts/build-native.mjs",
    "test": "node test-mcp.mjs && node test-plugin.mjs && node test-install.mjs && node test-plugins-install.mjs && node test-fusion-install.mjs && node test-browser-pointer.mjs && node test-browser-bridge.mjs && node test-bootstrap.mjs && node test-sdk.mjs",
    "test:state": "node scripts/test-native.mjs",
    "test:sdk": "node test-sdk.mjs",
    "test:routing": "node scripts/test-native.mjs --routing",
    "test:fusion": "node scripts/test-fusion.mjs",
    "test:fusion:windows": "node scripts/test-fusion-windows.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mint-hfut/AgentMouse.git"
  },
  "homepage": "https://github.com/Mint-hfut/AgentMouse",
  "bugs": {
    "url": "https://github.com/Mint-hfut/AgentMouse/issues"
  },
  "keywords": [
    "computer-use",
    "mcp",
    "mcp-server",
    "agent-skills",
    "desktop-automation",
    "windows",
    "claude-code",
    "codex",
    "zcode",
    "workbuddy",
    "dsh"
  ],
  "dependencies": {
    "smol-toml": "1.9.1",
    "yaml": "2.9.1"
  },
  "bundleDependencies": [
    "smol-toml",
    "yaml"
  ]
}
